# The Scholar's Shelf — Root Environment Template

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:5000/api
VITE_APP_TITLE=The Scholar's Shelf
VITE_APP_TAGLINE=Where Knowledge Finds Its Place.

# Backend
FLASK_APP=backend/run.py
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/scholars_shelf
MONGODB_DB_NAME=scholars_shelf
MONGODB_TIMEOUT_MS=2500
