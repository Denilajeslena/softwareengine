# The Scholar's Shelf - Backend Environment Configuration

# Application
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Database Configuration
# If left empty or unreachable, backend starts in unconfigured/offline database mode
MONGODB_URI=mongodb://localhost:27017/scholars_shelf
MONGODB_DB_NAME=scholars_shelf
MONGODB_TIMEOUT_MS=3000
